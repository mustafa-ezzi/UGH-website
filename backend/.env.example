DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Railway example:
# DJANGO_ALLOWED_HOSTS=courageous-charisma-production.up.railway.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://courageous-charisma-production.up.railway.app

# sqlite (default) or postgres
DATABASE_ENGINE=sqlite
# DATABASE_ENGINE=postgres
# Prefer DATABASE_URL on Railway (auto-injected when Postgres is linked):
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Or discrete vars:
# POSTGRES_DB=ugh_appliances
# POSTGRES_USER=ugh
# POSTGRES_PASSWORD=ugh
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (console prints to terminal locally; set SMTP for production)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@ugh-appliances.local
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Cloudflare R2 media (set USE_S3=True on Railway)
# USE_S3=True
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=ugh
# AWS_S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_S3_REGION_NAME=auto
# MEDIA_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
